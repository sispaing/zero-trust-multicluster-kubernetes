# =====================================================================
# lab.env - shared settings for the automated scripts AND the manual guides.
#
#   source ./lab.env
#
# Safe to source more than once. Re-source it after the first KinD cluster
# is created, so the IP addresses below get filled in.
# Do not add "set -e" here: it would close your terminal on any error.
# =====================================================================
set -a   # export every variable, so envsubst can see them

LAB_ROOT="${LAB_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)}"
RES="$LAB_ROOT/resources"          # static config files (committed to Git)
WORK="$LAB_ROOT/.work"             # generated files (never committed)
mkdir -p "$WORK"

# ---- Versions ----
ISTIO_VERSION="1.27.1"
CERT_MANAGER_VERSION="v1.18.2"
CALICO_VERSION="v3.28.2"
METALLB_VERSION="v0.14.9"
VAULT_IMAGE="hashicorp/vault:1.20"
POSTGRES_IMAGE="postgres:16"
NGINX_IMAGE="nginx:1.27-alpine"
APP_IMAGE="kanban-app:1.0"

# ---- Cluster 1 ----
C1="cluster1"
C1_POD_CIDR="10.10.0.0/16"
C1_SVC_CIDR="10.110.0.0/16"
C1_NETWORK="network1"
C1_ZONE="zone-1"

# ---- Cluster 2 ----
C2="cluster2"
C2_POD_CIDR="10.20.0.0/16"
C2_SVC_CIDR="10.120.0.0/16"
C2_NETWORK="network2"
C2_ZONE="zone-2"

# ---- Mesh and app ----
REGION="sg"
MESH_ID="mesh1"
APP_HOST="kanban.lab"
HTTPS_PORT="${HTTPS_PORT:-443}"
HTTP_PORT="${HTTP_PORT:-80}"
VAULT_PORT="8443"

# ---- Istio download location ----
ISTIO_DIR="$WORK/istio-$ISTIO_VERSION"
ISTIOCTL="$ISTIO_DIR/bin/istioctl"

# ---- Lab passwords (random, created once, kept in .work/) ----
if [ ! -f "$WORK/secrets.env" ]; then
  printf 'PG_SUPER_PASS=%s\nVAULT_DB_ADMIN_PASSWORD=%s\n' \
    "$(openssl rand -hex 16)" "$(openssl rand -hex 16)" > "$WORK/secrets.env"
  chmod 600 "$WORK/secrets.env"
fi
. "$WORK/secrets.env"

# ---- Fixed IPs on the Docker "kind" network (exists after the first cluster is created) ----
if docker network inspect kind >/dev/null 2>&1; then
  KIND_SUBNET=$(docker network inspect kind -f '{{range .IPAM.Config}}{{.Subnet}} {{end}}' | tr ' ' '\n' | grep -E '^[0-9]+\.' | head -1)
  case "$KIND_SUBNET" in
    */16) ;;
    *) echo "WARNING: kind network is $KIND_SUBNET; this lab expects a /16. Edit the IP section of lab.env." >&2 ;;
  esac
  P=$(echo "$KIND_SUBNET" | cut -d. -f1-2)
  NGINX_IP="$P.200.10"          # Nginx: app front door + Vault load balancer
  VAULT_LB_IP="$NGINX_IP"
  VAULT1_IP="$P.200.11"
  VAULT2_IP="$P.200.12"
  VAULT3_IP="$P.200.13"
  PG_IP="$P.200.20"
  C1_LB_RANGE="$P.255.200-$P.255.219"   # MetalLB pool for cluster1
  C2_LB_RANGE="$P.255.220-$P.255.239"   # MetalLB pool for cluster2
  LB_CIDR="$P.255.192/26"               # covers both pools
  VAULT_ADDR_EXT="https://$NGINX_IP:$VAULT_PORT"
fi

# Vault root token (after Vault is initialised)
if [ -f "$WORK/vault-init.json" ]; then
  VAULT_TOKEN=$(jq -r .root_token "$WORK/vault-init.json")
fi

set +a
